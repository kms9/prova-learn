{"$schema":"https://json-schema.org/draft/2020-12/schema","manifest_version":"2.1.0","description":"Canonical project-level LLM Wiki delivery contract for Prova Learn. All S1-S7 stages share one long-lived project workspace. Markdown Wiki pages are the current accepted meaning, JSONL is append-only history, and small JSON files are derived machine snapshots.","workspace":{"delivery_type":"project_llm_wiki","root_pattern":"workspace/<project-slug>","entrypoint":"INDEX.md","contract":".agents/project-workspace-contract.md","standalone_contract":".agents/standalone-invocation-contract.md","state_schema":".agents/project-state.schema.json","event_schema":".agents/project-event.schema.json","required_files":["INDEX.md","PROJECT.md","project-state.json","timeline.md"],"required_directories":["conversations","stages","knowledge","learner","plans","sessions","assessments","decisions","attachments","_machine"],"conversation":{"path_pattern":"conversations/YYYY-MM/<conversation-id>","required_files":["INDEX.md","transcript.md","events.jsonl","summary.md"],"append_only_files":["transcript.md","events.jsonl"]},"truth_layers":{"wiki":"Current accepted meaning and human/LLM navigation","events":"Append-only evidence, interaction, decision and state history","snapshot":"Derived current pointers, versions and machine state"},"legacy_run_policy":"read_only_migration_input"},"common_stage_files":["INDEX.md","working-notes.md","records.jsonl","decisions.md","gate.md","verification.md"],"stages":{"S1":{"skill_name":"al-s1-create-goal-success-contract","skill_dir":".agents/skills/s1-create-goal-success-contract","gate":"G1","delivery_type":"project_wiki_stage","stage_dir":"stages/s1-goal-contract","entrypoint":"INDEX.md","prerequisites":[],"required_stage_files":["goal-contract.md","research-brief.md","sources.jsonl","evidence-table.md","coverage.md","capabilities.jsonl","terminology.jsonl","confirmation.md"],"normal_route":"S2"},"S2":{"skill_name":"al-s2-create-domain-evidence-landscap