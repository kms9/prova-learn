{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prova-learn.local/schemas/project-state-1.0.0.json",
  "title": "prova_learn_project_state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "project_slug",
    "project_revision",
    "status",
    "current_stage",
    "route_to",
    "active_goal_id",
    "active_goal_version",
    "last_conversation_id",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^PRJ-[A-Za-z0-9._-]+$"},
    "project_slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "project_revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["initializing", "active", "blocked", "completed", "archived"]},
    "current_stage": {"enum": ["S1", "S2", "S3", "S4", "S5", "S6", "S7"]},
    "route_to": {"enum": ["S1", "S2", "S3", "S4", "S5", "S6", "S7", "complete"]},
    "active_goal_id": {"type": "string", "pattern": "^GOAL-[A-Za-z0-9._-]+$"},
    "active_goal_version": {"type": "integer", "minimum": 1},
    "active_learner_model_version": {"type": ["integer", "null"], "minimum": 1},
    "active_plan_id": {"type": ["string", "null"]},
    "active_session_id": {"type": ["string", "null"]},
    "last_conversation_id": {"type": "string", "pattern": "^CONV-[A-Za-z0-9._-]+$"},
    "stage_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "S1": {"$ref": "#/$defs/stage_status"},
        "S2": {"$ref": "#/$defs/stage_status"},
        "S3": {"$ref": "#/$defs/stage_status"},
        "S4": {"$ref": "#/$defs/stage_status"},
        "S5": {"$ref": "#/$defs/stage_status"},
        "S6": {"$ref": "#/$defs/stage_status"},
        "S7": {"$ref": "#/$defs/stage_status"}
      }
    },
    "updated_at": {"type": "string", "format": "date-time"},
    "updated_by_event_id": {"type": ["string", "null"], "pattern": "^EVT-[A-Za-z0-9._-]+$"}
  },
  "$defs": {
    "stage_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "gate", "route_to", "revision"],
      "properties": {
        "state": {"enum": ["not_started", "in_progress", "pending", "blocked", "completed", "superseded"]},
        "gate": {"enum": ["not_evaluated", "pass", "revise_here", "return_upstream", "blocked"]},
        "route_to": {"enum": ["S1", "S2", "S3", "S4", "S5", "S6", "S7", "complete"]},
        "revision": {"type": "integer", "minimum": 0},
        "entrypoint": {"type": ["string", "null"]}
      }
    }
  }
}
