{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills.example/schemas/personalized-learning-handoff-envelope-1.3.0.json",
  "title": "Personalized learning stage handoff envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage_id",
    "run_id",
    "status",
    "input_contract",
    "input_validation",
    "assumptions",
    "requirement_gaps",
    "confirmation",
    "evidence_collected",
    "processing_record",
    "positive_artifact",
    "quality_evaluation",
    "document_artifact",
    "presentation_artifact",
    "traceability",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.3.0"
    },
    "stage_id": {
      "enum": ["S1", "S2", "S3", "S4", "S5", "S6", "S7"]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "learner_id": {
      "type": ["string", "null"]
    },
    "status": {
      "enum": ["pending", "needs_confirmation", "blocked", "completed"]
    },
    "input_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_refs", "expected_schema_versions"],
      "properties": {
        "artifact_refs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "expected_schema_versions": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "input_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "missing_fields", "stale_inputs", "errors"],
      "properties": {
        "status": {"enum": ["pass", "fail"]},
        "missing_fields": {
          "type": "array",
          "items": {"type": "string"}
        },
        "stale_inputs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "errors": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "requirement_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "criticality", "gate_effect"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "criticality": {"enum": ["low", "medium", "high", "critical"]},
          "gate_effect": {"enum": ["none", "lower_confidence", "block"]}
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "trigger",
        "questions",
        "response",
        "status",
        "confirmed_at",
        "assumptions_changed"
      ],
      "properties": {
        "mode": {"enum": ["mandatory", "conditional", "inform"]},
        "trigger": {"type": ["string", "null"]},
        "questions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "response": {
          "type": ["object", "array", "string", "boolean", "null"]
        },
        "status": {
          "enum": ["pending", "confirmed", "rejected", "acknowledged", "corrected"]
        },
        "confirmed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "assumptions_changed": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "evidence_collected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "provenance", "source_ref", "summary", "status"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "provenance": {
            "enum": [
              "model_hypothesis",
              "market_signal",
              "external_evidence",
              "user_provided_unverified",
              "learner_behavior"
            ]
          },
          "source_ref": {"type": ["string", "null"]},
          "summary": {"type": "string", "minLength": 1},
          "status": {
            "enum": [
              "supported",
              "partially_supported",
              "unsupported",
              "unknown",
              "not_executed"
            ]
          }
        }
      }
    },
    "processing_record": {
      "type": "array",
      "items": {"type": "string"}
    },
    "positive_artifact": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "schema_version", "artifact_id", "content"],
          "properties": {
            "type": {"type": "string", "minLength": 1},
            "schema_version": {"type": "string", "minLength": 1},
            "artifact_id": {"type": "string", "minLength": 1},
            "content": {"type": "object"}
          }
        }
      ]
    },
    "quality_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rubric_results", "evidence", "verdict", "route_to"],
      "properties": {
        "rubric_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dimension",
              "evidence",
              "score",
              "threshold",
              "passed",
              "failure_action",
              "route_to"
            ],
            "properties": {
              "dimension": {"type": "string", "minLength": 1},
              "evidence": {
                "type": "array",
                "items": {"type": "string"}
              },
              "score": {"type": ["number", "boolean"]},
              "threshold": {"type": ["number", "boolean"]},
              "passed": {"type": "boolean"},
              "failure_action": {
                "type": ["string", "null"],
                "enum": ["revise_here", "return_upstream", null]
              },
              "route_to": {
                "type": ["string", "null"],
                "enum": ["S1", "S2", "S3", "S4", "S5", "S6", "S7", "complete", null]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "passed": {"const": false}
                  },
                  "required": ["passed"]
                },
                "then": {
                  "properties": {
                    "failure_action": {
                      "enum": ["revise_here", "return_upstream"]
                    },
                    "route_to": {
                      "enum": ["S1", "S2", "S3", "S4", "S5", "S6", "S7", "complete"]
                    }
                  }
                }
              }
            ]
          }
        },
        "evidence": {
          "type": "array",
          "items": {"type": "string"}
        },
        "verdict": {
          "enum": ["pass", "revise_here", "return_upstream", "blocked"]
        },
        "route_to": {
          "enum": ["S1", "S2", "S3", "S4", "S5", "S6", "S7", "complete"]
        }
      }
    },
    "document_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "status",
        "path",
        "authority",
        "source",
        "document_profile",
        "generation_order",
        "content_binding",
        "section_mappings",
        "generated_at",
        "validation",
        "reason"
      ],
      "properties": {
        "format": {"const": "markdown"},
        "status": {
          "enum": ["generated", "failed"]
        },
        "path": {
          "type": ["string", "null"]
        },
        "authority": {
          "const": "human_review_primary"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stage_id",
            "run_id",
            "artifact_id",
            "artifact_schema_version"
          ],
          "properties": {
            "stage_id": {
              "enum": ["S1", "S2", "S3", "S4", "S5", "S6", "S7"]
            },
            "run_id": {
              "type": "string",
              "minLength": 1
            },
            "artifact_id": {
              "type": ["string", "null"]
            },
            "artifact_schema_version": {
              "type": ["string", "null"]
            }
          }
        },
        "document_profile": {
          "enum": [
            "s1_goal_success_review",
            "s2_domain_evidence_review",
            "s3_capability_graph_review",
            "s4_learner_frontier_review",
            "s5_learning_plan_review",
            "s6_instructional_session_review",
            "s7_mastery_replan_review"
          ]
        },
        "generation_order": {
          "const": "markdown_before_json"
        },
        "content_binding": {
          "const": "lossless_semantic_correspondence"
        },
        "section_mappings": {
          "type": "array",
          "minItems": 11,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["section_id", "heading", "json_pointers", "status"],
            "properties": {
              "section_id": {
                "type": "string",
                "minLength": 1
              },
              "heading": {
                "type": "string",
                "minLength": 1
              },
              "json_pointers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^/"
                }
              },
              "status": {
                "enum": ["matched", "gap", "not_applicable"]
              }
            }
          }
        },
        "generated_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "markdown_parse",
            "required_sections",
            "json_correspondence",
            "no_placeholders"
          ],
          "properties": {
            "markdown_parse": {
              "enum": ["pass", "fail", "not_run"]
            },
            "required_sections": {
              "enum": ["pass", "fail", "not_run"]
            },
            "json_correspondence": {
              "enum": ["pass", "fail", "not_run"]
            },
            "no_placeholders": {
              "enum": ["pass", "fail", "not_run"]
            }
          }
        },
        "reason": {
          "type": ["string", "null"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"const": "generated"}
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "path": {"type": "string", "minLength": 1, "pattern": "\\.md$"},
              "generated_at": {"type": "string", "format": "date-time"},
              "reason": {"type": "null"},
              "section_mappings": {
                "not": {
                  "contains": {
                    "properties": {"status": {"const": "gap"}},
                    "required": ["status"]
                  }
                }
              },
              "validation": {
                "properties": {
                  "markdown_parse": {"const": "pass"},
                  "required_sections": {"const": "pass"},
                  "json_correspondence": {"const": "pass"},
                  "no_placeholders": {"const": "pass"}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {"const": "failed"}
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "path": {"type": "null"},
              "generated_at": {"type": "null"},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "presentation_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "status",
        "path",
        "authority",
        "source",
        "view_profile",
        "data_binding",
        "interaction_mode",
        "generated_at",
        "validation",
        "reason"
      ],
      "properties": {
        "format": {"const": "html"},
        "status": {
          "enum": ["generated", "failed"]
        },
        "path": {
          "type": ["string", "null"]
        },
        "authority": {
          "const": "derived_non_authoritative"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stage_id",
            "run_id",
            "envelope_schema_version",
            "artifact_id",
            "artifact_schema_version"
          ],
          "properties": {
            "stage_id": {
              "enum": ["S1", "S2", "S3", "S4", "S5", "S6", "S7"]
            },
            "run_id": {
              "type": "string",
              "minLength": 1
            },
            "envelope_schema_version": {
              "const": "1.3.0"
            },
            "artifact_id": {
              "type": ["string", "null"]
            },
            "artifact_schema_version": {
              "type": ["string", "null"]
            }
          }
        },
        "view_profile": {
          "enum": [
            "goal_contract_dashboard",
            "evidence_landscape_workbench",
            "capability_graph_explorer",
            "learner_frontier_diagnostic",
            "learning_plan_board",
            "instructional_session_workspace",
            "mastery_replan_console"
          ]
        },
        "data_binding": {
          "const": "embedded_canonical_envelope"
        },
        "interaction_mode": {
          "const": "read_only_exploration"
        },
        "generated_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "html_parse",
            "accessibility_smoke",
            "interaction_smoke"
          ],
          "properties": {
            "html_parse": {
              "enum": ["pass", "fail", "not_run"]
            },
            "accessibility_smoke": {
              "enum": ["pass", "fail", "not_run"]
            },
            "interaction_smoke": {
              "enum": ["pass", "fail", "not_run"]
            }
          }
        },
        "reason": {
          "type": ["string", "null"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"const": "generated"}
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "generated_at": {"type": "string", "format": "date-time"},
              "reason": {"type": "null"},
              "validation": {
                "properties": {
                  "html_parse": {"const": "pass"},
                  "accessibility_smoke": {"const": "pass"},
                  "interaction_smoke": {"const": "pass"}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {"const": "failed"}
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "path": {"type": "null"},
              "generated_at": {"type": "null"},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_artifact_ids",
        "source_evidence_ids",
        "source_sections",
        "fixture_type"
      ],
      "properties": {
        "source_artifact_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "source_evidence_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "source_sections": {
          "type": "array",
          "items": {"type": "string"}
        },
        "fixture_type": {
          "enum": ["simulated_fixture", "observed", "mixed", "not_applicable"]
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"stage_id": {"const": "S1"}},
        "required": ["stage_id"]
      },
      "then": {
        "properties": {
          "document_artifact": {
            "properties": {
              "document_profile": {"const": "s1_goal_success_review"},
              "section_mappings": {"minItems": 11},
              "source": {
                "properties": {"stage_id": {"const": "S1"}}
              }
            }
          },
          "presentation_artifact": {
            "properties": {
              "view_profile": {"const": "goal_contract_dashboard"},
              "source": {
                "properties": {"stage_id": {"const": "S1"}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"stage_id": {"const": "S2"}},
        "required": ["stage_id"]
      },
      "then": {
        "properties": {
          "document_artifact": {
            "properties": {
              "document_profile": {"const": "s2_domain_evidence_review"},
              "section_mappings": {"minItems": 13},
              "source": {
                "properties": {"stage_id": {"const": "S2"}}
              }
            }
          },
          "presentation_artifact": {
            "properties": {
              "view_profile": {"const": "evidence_landscape_workbench"},
              "source": {
                "properties": {"stage_id": {"const": "S2"}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"stage_id": {"const": "S3"}},
        "required": ["stage_id"]
      },
      "then": {
        "properties": {
          "document_artifact": {
            "properties": {
              "document_profile": {"const": "s3_capability_graph_review"},
              "section_mappings": {"minItems": 14},
              "source": {
                "properties": {"stage_id": {"const": "S3"}}
              }
            }
          },
          "presentation_artifact": {
            "properties": {
              "view_profile": {"const": "capability_graph_explorer"},
              "source": {
                "properties": {"stage_id": {"const": "S3"}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"stage_id": {"const": "S4"}},
        "required": ["stage_id"]
      },
      "then": {
        "properties": {
          "document_artifact": {
            "properties": {
              "document_profile": {"const": "s4_learner_frontier_review"},
              "section_mappings": {"minItems": 13},
              "source": {
                "properties": {"stage_id": {"const": "S4"}}
              }
            }
          },
          "presentation_artifact": {
            "properties": {
              "view_profile": {"const": "learner_frontier_diagnostic"},
              "source": {
                "properties": {"stage_id": {"const": "S4"}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"stage_id": {"const": "S5"}},
        "required": ["stage_id"]
      },
      "then": {
        "properties": {
          "document_artifact": {
            "properties": {
              "document_profile": {"const": "s5_learning_plan_review"},
              "section_mappings": {"minItems": 13},
              "source": {
                "properties": {"stage_id": {"const": "S5"}}
              }
            }
          },
          "presentation_artifact": {
            "properties": {
              "view_profile": {"const": "learning_plan_board"},
              "source": {
                "properties": {"stage_id": {"const": "S5"}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"stage_id": {"const": "S6"}},
        "required": ["stage_id"]
      },
      "then": {
        "properties": {
          "document_artifact": {
            "properties": {
              "document_profile": {"const": "s6_instructional_session_review"},
              "section_mappings": {"minItems": 12},
              "source": {
                "properties": {"stage_id": {"const": "S6"}}
              }
            }
          },
          "presentation_artifact": {
            "properties": {
              "view_profile": {"const": "instructional_session_workspace"},
              "source": {
                "properties": {"stage_id": {"const": "S6"}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"stage_id": {"const": "S7"}},
        "required": ["stage_id"]
      },
      "then": {
        "properties": {
          "document_artifact": {
            "properties": {
              "document_profile": {"const": "s7_mastery_replan_review"},
              "section_mappings": {"minItems": 13},
              "source": {
                "properties": {"stage_id": {"const": "S7"}}
              }
            }
          },
          "presentation_artifact": {
            "properties": {
              "view_profile": {"const": "mastery_replan_console"},
              "source": {
                "properties": {"stage_id": {"const": "S7"}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {"positive_artifact": {"type": "null"}},
        "required": ["positive_artifact"]
      },
      "then": {
        "properties": {
          "document_artifact": {
            "properties": {
              "source": {
                "properties": {
                  "artifact_id": {"type": "null"},
                  "artifact_schema_version": {"type": "null"}
                }
              }
            }
          },
          "presentation_artifact": {
            "properties": {
              "source": {
                "properties": {
                  "artifact_id": {"type": "null"},
                  "artifact_schema_version": {"type": "null"}
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "document_artifact": {
            "properties": {
              "source": {
                "properties": {
                  "artifact_id": {"type": "string", "minLength": 1},
                  "artifact_schema_version": {"type": "string", "minLength": 1}
                }
              }
            }
          },
          "presentation_artifact": {
            "properties": {
              "source": {
                "properties": {
                  "artifact_id": {"type": "string", "minLength": 1},
                  "artifact_schema_version": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "input_validation": {
            "properties": {
              "status": {"const": "fail"}
            },
            "required": ["status"]
          }
        },
        "required": ["input_validation"]
      },
      "then": {
        "properties": {
          "positive_artifact": {"type": "null"}
        }
      }
    }
  ]
}
