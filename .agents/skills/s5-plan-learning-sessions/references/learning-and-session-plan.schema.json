{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills.example/schemas/learning-and-session-plan-1.1.0.json",
  "title": "learning_and_session_plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schema_version",
    "artifact_id",
    "content"
  ],
  "properties": {
    "type": {
      "const": "learning_and_session_plan"
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_goals",
        "ordered_learning_nodes",
        "sessions",
        "assessment_schedule",
        "review_anchors",
        "risks",
        "alternative_routes",
        "exit_criteria"
      ],
      "properties": {
        "stage_goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "goal_id",
              "statement"
            ],
            "properties": {
              "goal_id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "ordered_learning_nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "order",
              "selection_rationale",
              "evidence_basis",
              "teaching_strategy",
              "scaffolding",
              "fade_conditions"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "selection_rationale": {
                "type": "string",
                "minLength": 1
              },
              "evidence_basis": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "knowledge_tier",
                  "knowledge_status",
                  "freshness",
                  "source_refs",
                  "inclusion_reason"
                ],
                "properties": {
                  "knowledge_tier": {
                    "enum": [
                      "core_stable",
                      "core_practice",
                      "research_frontier",
                      "emerging_signal"
                    ]
                  },
                  "knowledge_status": {
                    "enum": [
                      "consensus",
                      "disputed",
                      "emerging",
                      "insufficient_evidence",
                      "deprecated"
                    ]
                  },
                  "freshness": {"enum": ["stable", "dynamic"]},
                  "source_refs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {"type": "string", "minLength": 1}
                  },
                  "inclusion_reason": {"type": "string", "minLength": 1}
                }
              },
              "teaching_strategy": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "explain",
                    "worked_example",
                    "practice",
                    "retrieval",
                    "interleaving",
                    "transfer",
                    "delayed_retest",
                    "contrast_case"
                  ]
                }
              },
              "scaffolding": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "approach",
                  "description"
                ],
                "properties": {
                  "approach": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "fade_conditions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "sessions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "session_id",
              "goal",
              "activities",
              "estimated_time",
              "input_materials"
            ],
            "properties": {
              "session_id": {
                "type": "string",
                "minLength": 1
              },
              "goal": {
                "type": "string",
                "minLength": 1
              },
              "activities": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "estimated_time": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "minutes_per_session",
                  "session_count"
                ],
                "properties": {
                  "minutes_per_session": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "session_count": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              },
              "input_materials": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "assessment_schedule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "immediate",
            "transfer",
            "delayed"
          ],
          "properties": {
            "immediate": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "transfer": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "delayed": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "review_anchors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "risks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "risk_id",
              "description",
              "mitigation",
              "criticality"
            ],
            "properties": {
              "risk_id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "mitigation": {
                "type": "string",
                "minLength": 1
              },
              "criticality": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            }
          }
        },
        "alternative_routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trigger",
              "adjustment"
            ],
            "properties": {
              "trigger": {
                "type": "string",
                "minLength": 1
              },
              "adjustment": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "exit_criteria": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "per_node",
            "overall"
          ],
          "properties": {
            "per_node": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "node_id",
                  "criteria"
                ],
                "properties": {
                  "node_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "criteria": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            },
            "overall": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
