{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills.example/schemas/capability-concept-graph-1.2.0.json",
  "title": "capability_concept_graph",
  "description": "S3 capability-outline and concept-graph artifact. Capability containment, learning-unit to node coverage, and node prerequisites are distinct relationship classes. Every learning unit needs a core atomic node, every mapping reference must resolve, and the directed hard-prerequisite subgraph must be acyclic. A topic directory without assessable units, valid mappings, named prerequisite edges, per-node assessment, or S1/S2 traceability is invalid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schema_version",
    "artifact_id",
    "content"
  ],
  "properties": {
    "type": {
      "const": "capability_concept_graph"
    },
    "schema_version": {
      "const": "1.2.0"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_atom_mappings",
        "knowledge_status_summary",
        "role_capability_ladder",
        "coverage_and_gap_report",
        "target_capabilities",
        "learning_units",
        "nodes",
        "unit_node_mappings",
        "edges",
        "assessment_items",
        "mastery_thresholds",
        "remediation_entries",
        "traceability"
      ],
      "properties": {
        "focus_question": {
          "type": "string",
          "minLength": 1
        },
        "goal_contract_ref": {
          "type": "string",
          "minLength": 1
        },
        "evidence_landscape_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_atom_mappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item_id",
              "object_type",
              "target_refs",
              "source_refs"
            ],
            "properties": {
              "item_id": {"type": "string", "minLength": 1},
              "object_type": {
                "enum": [
                  "task",
                  "capability",
                  "knowledge",
                  "skill",
                  "evidence",
                  "tool",
                  "practice",
                  "failure",
                  "misconception",
                  "research_question",
                  "role",
                  "source"
                ]
              },
              "target_refs": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "knowledge_status_summary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "knowledge_tier",
              "knowledge_status",
              "freshness",
              "source_categories",
              "applicability"
            ],
            "properties": {
              "node_id": {"type": "string", "minLength": 1},
              "knowledge_tier": {
                "enum": [
                  "core_stable",
                  "core_practice",
                  "research_frontier",
                  "emerging_signal"
                ]
              },
              "knowledge_status": {
                "enum": [
                  "consensus",
                  "disputed",
                  "emerging",
                  "insufficient_evidence",
                  "deprecated"
                ]
              },
              "freshness": {"enum": ["stable", "dynamic"]},
              "source_categories": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "job_career",
                    "books_courses",
                    "papers_research",
                    "community_web",
                    "standards_official",
                    "artifacts_validation"
                  ]
                }
              },
              "applicability": {"type": "string", "minLength": 1}
            }
          }
        },
        "role_capability_ladder": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role_or_level",
              "capability_id",
              "autonomy",
              "complexity",
              "influence",
              "accountability",
              "mastery_depth",
              "source_refs"
            ],
            "properties": {
              "role_or_level": {"type": "string", "minLength": 1},
              "capability_id": {"type": "string", "minLength": 1},
              "autonomy": {"type": "string", "minLength": 1},
              "complexity": {"type": "string", "minLength": 1},
              "influence": {"type": "string", "minLength": 1},
              "accountability": {"type": "string", "minLength": 1},
              "mastery_depth": {"type": "string", "minLength": 1},
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "coverage_and_gap_report": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "covered_core_node_ids",
            "gaps",
            "upstream_return_required"
          ],
          "properties": {
            "covered_core_node_ids": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "gaps": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "upstream_return_required": {"const": false}
          }
        },
        "target_capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "capability_id",
              "statement",
              "sub_capabilities",
              "typical_tasks"
            ],
            "properties": {
              "capability_id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "sub_capabilities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "sub_capability_id",
                    "statement"
                  ],
                  "properties": {
                    "sub_capability_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "statement": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "typical_tasks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "learning_units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unit_id",
              "title",
              "parent_ref",
              "parent_level",
              "outcome",
              "goal_refs",
              "source_refs",
              "scope_role"
            ],
            "properties": {
              "unit_id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "parent_ref": {
                "type": "string",
                "minLength": 1
              },
              "parent_level": {
                "enum": [
                  "target_capability",
                  "sub_capability"
                ]
              },
              "outcome": {
                "type": "string",
                "minLength": 1
              },
              "goal_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "scope_role": {
                "enum": [
                  "required",
                  "optional",
                  "extension"
                ]
              }
            }
          }
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "node_type",
              "capability_statement",
              "common_misconceptions"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "node_type": {
                "enum": [
                  "concept",
                  "procedure",
                  "strategy",
                  "representation",
                  "metacognition"
                ]
              },
              "capability_statement": {
                "type": "string",
                "minLength": 1
              },
              "common_misconceptions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "unit_node_mappings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unit_id",
              "node_id",
              "coverage_role",
              "rationale"
            ],
            "properties": {
              "unit_id": {
                "type": "string",
                "minLength": 1
              },
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "coverage_role": {
                "enum": [
                  "core",
                  "supporting",
                  "extension"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from_node",
              "to_node",
              "prerequisite_strength",
              "rationale"
            ],
            "properties": {
              "from_node": {
                "type": "string",
                "minLength": 1
              },
              "to_node": {
                "type": "string",
                "minLength": 1
              },
              "prerequisite_strength": {
                "enum": [
                  "hard",
                  "soft"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "assessment_items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "item",
              "cognitive_level"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "item": {
                "type": "string",
                "minLength": 1
              },
              "cognitive_level": {
                "enum": [
                  "explain",
                  "apply",
                  "diagnose",
                  "evaluate",
                  "transfer",
                  "remember"
                ]
              }
            }
          }
        },
        "mastery_thresholds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "threshold",
              "requires_transfer"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "threshold": {
                "type": "string",
                "minLength": 1
              },
              "requires_transfer": {
                "type": "boolean"
              }
            }
          }
        },
        "remediation_entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "trigger",
              "entry"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "trigger": {
                "type": "string",
                "minLength": 1
              },
              "entry": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "traceability": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "source_refs",
              "goal_refs",
              "assessment_refs"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "goal_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "assessment_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
