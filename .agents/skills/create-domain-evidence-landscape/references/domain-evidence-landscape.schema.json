{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills.example/schemas/domain-evidence-landscape-1.0.0.json",
  "title": "domain_evidence_landscape",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schema_version",
    "artifact_id",
    "content"
  ],
  "properties": {
    "type": {
      "const": "domain_evidence_landscape"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "terminology",
        "research_executed",
        "research_run_manifest",
        "source_ledger",
        "category_coverage",
        "core_questions_and_mental_models",
        "jd_capability_matrix",
        "interview_assessment_matrix",
        "consensus",
        "disagreements",
        "open_problems",
        "claims",
        "evidence_gaps"
      ],
      "properties": {
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "topic",
            "region_language",
            "time_boundary"
          ],
          "properties": {
            "topic": {
              "type": "string",
              "minLength": 1
            },
            "region_language": {
              "type": "string",
              "minLength": 1
            },
            "time_boundary": {
              "type": "string",
              "minLength": 1
            },
            "role_or_scene": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "terminology": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "term",
              "meaning",
              "evidence_refs"
            ],
            "properties": {
              "term": {
                "type": "string",
                "minLength": 1
              },
              "meaning": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "research_executed": {
          "type": "boolean"
        },
        "research_run_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "online",
            "execution_status",
            "started_at",
            "rounds",
            "perspectives",
            "queries"
          ],
          "properties": {
            "online": {
              "type": "boolean"
            },
            "execution_status": {
              "enum": [
                "completed",
                "partial",
                "not_executed",
                "blocked"
              ]
            },
            "started_at": {
              "type": "string",
              "format": "date-time"
            },
            "completed_at": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "rounds": {
              "type": "integer",
              "minimum": 1
            },
            "perspectives": {
              "type": "array",
              "minItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "name",
                  "questions",
                  "query_ids"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "enum": [
                      "terminology_history",
                      "theory_standards",
                      "practice_tasks",
                      "recruiting_market",
                      "interview_assessment",
                      "criticism_frontier",
                      "other"
                    ]
                  },
                  "questions": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "query_ids": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            "queries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "query_id",
                  "query",
                  "executed_at",
                  "result_summary"
                ],
                "properties": {
                  "query_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "query": {
                    "type": "string",
                    "minLength": 1
                  },
                  "executed_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "result_summary": {
                    "type": "string",
                    "minLength": 1
                  },
                  "follow_up_of": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "follow_up_triggers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "source_ledger": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_id",
              "url",
              "title",
              "publisher",
              "source_category",
              "published_at",
              "retrieved_at",
              "region",
              "reliability",
              "provenance",
              "applicability"
            ],
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "publisher": {
                "type": "string",
                "minLength": 1
              },
              "source_category": {
                "enum": [
                  "wikipedia_encyclopedia",
                  "official_academic",
                  "practice_case",
                  "recruiting_jd",
                  "interview_selection",
                  "adversarial_frontier"
                ]
              },
              "published_at": {
                "description": "Preserve the source's actual published-date precision; do not invent missing month or day values.",
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "format": "date"
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
                  },
                  {
                    "type": "string",
                    "pattern": "^[0-9]{4}$"
                  }
                ]
              },
              "retrieved_at": {
                "type": "string",
                "format": "date-time"
              },
              "region": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reliability": {
                "enum": [
                  "high",
                  "medium",
                  "low",
                  "unknown"
                ]
              },
              "provenance": {
                "enum": [
                  "model_hypothesis",
                  "market_signal",
                  "external_evidence",
                  "user_provided_unverified",
                  "learner_behavior"
                ]
              },
              "applicability": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "category_coverage": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "category",
              "status",
              "reason",
              "criticality",
              "gate_effect"
            ],
            "properties": {
              "category": {
                "enum": [
                  "wikipedia_encyclopedia",
                  "official_academic",
                  "practice_case",
                  "recruiting_jd",
                  "interview_selection",
                  "adversarial_frontier"
                ]
              },
              "status": {
                "enum": [
                  "covered",
                  "not_applicable",
                  "gap"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "criticality": {
                "enum": [
                  "critical",
                  "material",
                  "minor"
                ]
              },
              "gate_effect": {
                "enum": [
                  "none",
                  "lower_confidence",
                  "block"
                ]
              },
              "sample_count": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          }
        },
        "core_questions_and_mental_models": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "core_questions",
            "mental_models"
          ],
          "properties": {
            "core_questions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "mental_models": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "model",
                  "description",
                  "evidence_refs"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "jd_capability_matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task",
              "capability",
              "skill",
              "tool",
              "background",
              "evidence_refs"
            ],
            "properties": {
              "task": {
                "type": "string",
                "minLength": 1
              },
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "skill": {
                "type": "string"
              },
              "tool": {
                "type": "string"
              },
              "background": {
                "type": "string"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "interview_assessment_matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "capability",
              "level",
              "credibility",
              "evidence_refs"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "capability": {
                "type": "string",
                "minLength": 1
              },
              "level": {
                "type": "string",
                "minLength": 1
              },
              "credibility": {
                "enum": [
                  "high",
                  "medium",
                  "low",
                  "unknown"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "consensus": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "statement",
              "evidence_refs"
            ],
            "properties": {
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "disagreements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "issue",
              "side_a",
              "side_b",
              "status"
            ],
            "properties": {
              "issue": {
                "type": "string",
                "minLength": 1
              },
              "side_a": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "position",
                  "strong_arguments",
                  "evidence_refs"
                ],
                "properties": {
                  "position": {
                    "type": "string",
                    "minLength": 1
                  },
                  "strong_arguments": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "side_b": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "position",
                  "strong_arguments",
                  "evidence_refs"
                ],
                "properties": {
                  "position": {
                    "type": "string",
                    "minLength": 1
                  },
                  "strong_arguments": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "evidence_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "status": {
                "enum": [
                  "unresolved",
                  "partial_resolution",
                  "frontier"
                ]
              }
            }
          }
        },
        "open_problems": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "problem",
              "why_it_matters",
              "evidence_refs"
            ],
            "properties": {
              "problem": {
                "type": "string",
                "minLength": 1
              },
              "why_it_matters": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim_id",
              "statement",
              "status",
              "claim_type",
              "evidence_refs"
            ],
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "supported",
                  "partially_supported",
                  "unsupported"
                ]
              },
              "claim_type": {
                "enum": [
                  "fact",
                  "standard",
                  "market_signal",
                  "practice",
                  "inference"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "limits": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "evidence_gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gap_id",
              "description",
              "criticality",
              "gate_effect",
              "confidence_impact"
            ],
            "properties": {
              "gap_id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "criticality": {
                "enum": [
                  "critical",
                  "material",
                  "minor"
                ]
              },
              "gate_effect": {
                "enum": [
                  "none",
                  "lower_confidence",
                  "block"
                ]
              },
              "confidence_impact": {
                "enum": [
                  "none",
                  "low",
                  "medium",
                  "high"
                ]
              }
            }
          }
        }
      }
    }
  }
}
