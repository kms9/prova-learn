{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills.example/schemas/personalized-learning-handoff-envelope-1.0.0.json",
  "title": "Personalized learning stage handoff envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage_id",
    "run_id",
    "status",
    "input_contract",
    "input_validation",
    "assumptions",
    "requirement_gaps",
    "confirmation",
    "evidence_collected",
    "processing_record",
    "positive_artifact",
    "quality_evaluation",
    "traceability",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "stage_id": {
      "enum": ["S1", "S2", "S3", "S4", "S5", "S6", "S7"]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "learner_id": {
      "type": ["string", "null"]
    },
    "status": {
      "enum": ["pending", "blocked", "completed"]
    },
    "input_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_refs", "expected_schema_versions"],
      "properties": {
        "artifact_refs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "expected_schema_versions": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "input_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "missing_fields", "stale_inputs", "errors"],
      "properties": {
        "status": {"enum": ["pass", "fail"]},
        "missing_fields": {
          "type": "array",
          "items": {"type": "string"}
        },
        "stale_inputs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "errors": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "requirement_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "criticality", "gate_effect"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "criticality": {"enum": ["low", "medium", "high", "critical"]},
          "gate_effect": {"enum": ["none", "lower_confidence", "block"]}
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "trigger",
        "questions",
        "response",
        "status",
        "confirmed_at",
        "assumptions_changed"
      ],
      "properties": {
        "mode": {"enum": ["mandatory", "conditional", "inform"]},
        "trigger": {"type": ["string", "null"]},
        "questions": {
          "type": "array",
          "items": {"type": "string"}
        },
        "response": {
          "type": ["object", "array", "string", "boolean", "null"]
        },
        "status": {
          "enum": ["pending", "confirmed", "rejected", "acknowledged", "corrected"]
        },
        "confirmed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "assumptions_changed": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "evidence_collected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "provenance", "source_ref", "summary", "status"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "provenance": {
            "enum": [
              "model_hypothesis",
              "market_signal",
              "external_evidence",
              "user_provided_unverified",
              "learner_behavior"
            ]
          },
          "source_ref": {"type": ["string", "null"]},
          "summary": {"type": "string", "minLength": 1},
          "status": {
            "enum": [
              "supported",
              "partially_supported",
              "unsupported",
              "unknown",
              "not_executed"
            ]
          }
        }
      }
    },
    "processing_record": {
      "type": "array",
      "items": {"type": "string"}
    },
    "positive_artifact": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "schema_version", "artifact_id", "content"],
          "properties": {
            "type": {"type": "string", "minLength": 1},
            "schema_version": {"type": "string", "minLength": 1},
            "artifact_id": {"type": "string", "minLength": 1},
            "content": {"type": "object"}
          }
        }
      ]
    },
    "quality_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rubric_results", "evidence", "verdict", "route_to"],
      "properties": {
        "rubric_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dimension",
              "evidence",
              "score",
              "threshold",
              "passed",
              "failure_action",
              "route_to"
            ],
            "properties": {
              "dimension": {"type": "string", "minLength": 1},
              "evidence": {
                "type": "array",
                "items": {"type": "string"}
              },
              "score": {"type": ["number", "boolean"]},
              "threshold": {"type": ["number", "boolean"]},
              "passed": {"type": "boolean"},
              "failure_action": {
                "type": ["string", "null"],
                "enum": ["revise_here", "return_upstream", null]
              },
              "route_to": {
                "type": ["string", "null"],
                "enum": ["S1", "S2", "S3", "S4", "S5", "S6", "S7", "complete", null]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "passed": {"const": false}
                  },
                  "required": ["passed"]
                },
                "then": {
                  "properties": {
                    "failure_action": {
                      "enum": ["revise_here", "return_upstream"]
                    },
                    "route_to": {
                      "enum": ["S1", "S2", "S3", "S4", "S5", "S6", "S7", "complete"]
                    }
                  }
                }
              }
            ]
          }
        },
        "evidence": {
          "type": "array",
          "items": {"type": "string"}
        },
        "verdict": {
          "enum": ["pass", "revise_here", "return_upstream", "blocked"]
        },
        "route_to": {
          "enum": ["S1", "S2", "S3", "S4", "S5", "S6", "S7", "complete"]
        }
      }
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_artifact_ids",
        "source_evidence_ids",
        "source_sections",
        "fixture_type"
      ],
      "properties": {
        "source_artifact_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "source_evidence_ids": {
          "type": "array",
          "items": {"type": "string"}
        },
        "source_sections": {
          "type": "array",
          "items": {"type": "string"}
        },
        "fixture_type": {
          "enum": ["simulated_fixture", "observed", "mixed", "not_applicable"]
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "input_validation": {
            "properties": {
              "status": {"const": "fail"}
            },
            "required": ["status"]
          }
        },
        "required": ["input_validation"]
      },
      "then": {
        "properties": {
          "positive_artifact": {"type": "null"}
        }
      }
    }
  ]
}
